}

function openaiPost(string $url, array $payload, string $apiKey): array {
    return httpJsonPost($url, $payload, [
        'Authorization: Bearer ' . $apiKey,
    ]);
}

function pineconePost(string $url, array $payload, string $apiKey): array {
    return httpJsonPost($url, $payload, [
        'Api-Key: ' . $apiKey,
    ]);
}

function httpJsonPost(string $url, array $payload, array $extraHeaders): array {
    $headers = array_merge([
        'Content-Type: application/json',
        'Accept: application/json',
    ], $extraHeaders);

    $ch = curl_init($url);
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_POST           => true,
        CURLOPT_HTTPHEADER     => $headers,
        CURLOPT_POSTFIELDS     => json_encode($payload),
        CURLOPT_TIMEOUT        => 45,
    ]);

    $body     = curl_exec($ch);
    $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $error    = curl_error($ch);
    curl_close($ch);

    if ($body === false) {
        throw new RuntimeException("HTTP request to {$url} failed: {$error}");
    }
    if ($httpCode < 200 || $httpCode >= 300) {
        throw new RuntimeException("HTTP {$httpCode} from {$url}: {$body}");
    }

    $decoded = json_decode($body, true);
    if (!is_array($decoded)) {
        throw new RuntimeException("Invalid JSON from {$url}: {$body}");
    }

    return $decoded;
}
