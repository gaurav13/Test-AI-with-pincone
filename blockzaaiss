    appendFact($facts, 'Founded', $founded);
    appendFact($facts, 'Team Size', $teamSize);
    appendFact($facts, 'Funding', $funding);
    appendFact($facts, 'Focus Areas', $focus);
    appendFact($facts, 'Keywords', $keywords);

    return [
