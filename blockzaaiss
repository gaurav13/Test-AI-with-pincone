    $name = getMetaString($metadata, ['company', 'company_name', 'companyName', 'name', 'title', 'displayName']);
    if ($name === '') {
        $name = valueToPlainString($match['id'] ?? '');
    }

    $tagline = getMetaString($metadata, ['tagline', 'subtitle', 'short_description', 'shortDescription', 'headline']);
    $description = getMetaString($metadata, ['description', 'summary_text', 'Summary_text', 'overview', 'summary', 'about', 'body', 'context']);
    $category = getMetaString($metadata, ['category', 'subcategory', 'category_name', 'industry', 'segment']);
    $location = getMetaString($metadata, ['location', 'primary_location', 'hq', 'headquarters', 'headquarters_location', 'country', 'city', 'region']);
    $website = ensureUrl(getMetaString($metadata, ['website', 'website_url', 'websiteUrl', 'founder_domain', 'official_site', 'officialSite', 'url']));
    $directoryLink = ensureUrl(getMetaString($metadata, ['directoryUrl', 'directory_url', 'directoryLink', 'profile_url', 'profileUrl', 'url']));
