    foreach ($existing as $idx => $member) {
        if (!is_array($member)) {
            continue;
        }
        $name = strtolower($member['name'] ?? '');
        if ($name !== '') {
            $index[$name] = $idx;
        }
    }

    foreach ($supplement as $member) {
        if (!is_array($member)) {
            continue;
        }
        $name = strtolower($member['name'] ?? '');
        if ($name === '') {
            continue;
        }

        if (isset($index[$name])) {
            $idx = $index[$name];
            foreach ($member as $key => $value) {
                if ($value === '' || $value === null) {
                    continue;
                }
                if (!array_key_exists($key, $existing[$idx]) || $existing[$idx][$key] === '' || $existing[$idx][$key] === null) {
