function shuffleSimilarCompanies(array $companies, string $primaryName = '', int $limit = 6): array {
    if (!$companies) {
        return [];
    }

    $primaryKey = $primaryName !== '' ? slugify($primaryName) : '';
    $unique = [];

    foreach ($companies as $company) {
        if (!is_array($company)) {
            continue;
        }
        $name = trim((string)($company['name'] ?? ''));
        if ($name === '') {
            continue;
        }
        $slug = slugify($name);
        if ($primaryKey !== '' && $slug === $primaryKey) {
            continue;
        }
        if (isset($unique[$slug])) {
            $unique[$slug] = mergeCompanyPreview($unique[$slug], $company);
        } else {
            $unique[$slug] = $company;
        }
    }

    if (!$unique) {
        return [];
    }

    $shuffled = array_values($unique);
    shuffle($shuffled);

    if ($limit > 0 && count($shuffled) > $limit) {
        $shuffled = array_slice($shuffled, 0, $limit);
    }

    return $shuffled;
}

function mapTeamMembersForResponse(array $teamMembers, string $companyName = '', array $highlightNames = []): array {
    $result = [];
    $highlightLookup = array_map(
        static function ($value) {
            return strtolower(trim((string)$value));
        },
        array_filter($highlightNames, static function ($value) {
            return trim((string)$value) !== '';
        })
    );

    foreach ($teamMembers as $member) {
        if (!is_array($member)) {
            continue;
        }
        $formatted = formatTeamMemberForResponse(
            $member,
            $companyName,
            in_array(strtolower($member['name'] ?? ''), $highlightLookup, true)
        );
        if ($formatted && !empty($formatted['name'])) {
            $result[] = $formatted;
        }
    }
    return $result;
}

function formatTeamMemberForResponse(array $member, string $companyName = '', bool $isPrimary = false): array {
    $name = $member['name'] ?? '';
    if ($name === '') {
        return [];
    }

    $profileUrl = ensureUrl($member['profileUrl'] ?? '');
    if ($profileUrl === '' && $name !== '') {
        $profileUrl = 'https://blockza.io/team-member/' . rawurlencode(slugify($name));
    }
    if ($profileUrl === 'https://blockza.io/') {
        $profileUrl = '';
    }

    $image = ensureUrl($member['image'] ?? '');

    return [
        'name'          => $name,
        'role'          => $member['role'] ?? '',
        'bio'           => truncateText($member['description'] ?? '', 280),
        'image'         => $image,
        'profileUrl'    => $profileUrl,
        'bookMeetingId' => 'BookMeeting_' . sanitizeIdFragment($name),
        'company'       => $companyName,
        'isPrimary'     => $isPrimary,
    ];
}

function buildSummaryForLayout(string $layout, array $context = []): array {
    $modelSummary = isset($context['modelSummary']) && is_array($context['modelSummary'])
        ? $context['modelSummary']
        : [];

    $modelTitle = valueToPlainString($modelSummary['title'] ?? '');
    $modelSubtitle = valueToPlainString($modelSummary['subtitle'] ?? '');
    $modelDescription = valueToPlainString($modelSummary['description'] ?? ($modelSummary['summary'] ?? ''));

    if ($layout === 'company') {
        $company = $context['company'] ?? [];
        return [
            'title'       => $company['name'] ?? $modelTitle,
            'subtitle'    => $company['tagline'] ?? $modelSubtitle,
            'description' => $company['description'] ?? $modelDescription,
        ];
    }

    if ($layout === 'team') {
        $primary = $context['primaryPerson'] ?? [];
        return [
            'title'       => $primary['name'] ?? $modelTitle,
            'subtitle'    => $primary['role'] ?? $modelSubtitle,
            'description' => $primary['bio'] ?? $modelDescription,
        ];
    }

    return [
        'title'       => $modelTitle !== '' ? $modelTitle : 'Blockza Insight',
        'subtitle'    => $modelSubtitle,
        'description' => $modelDescription,
    ];
}

function buildSectionsForLayout(string $layout, array $modelData = []): array {
    if ($layout !== 'general') {
        return [];
    }

    $sections = [];
    $rawSections = $modelData['sections'] ?? [];
    if (!is_array($rawSections)) {
        return [];
    }
    if (!blockza_is_list($rawSections)) {
        $rawSections = array_values($rawSections);
    }

    foreach ($rawSections as $section) {
        if (!is_array($section)) {
            continue;
        }
        $heading = valueToPlainString($section['heading'] ?? '');
        $body = valueToPlainString($section['body'] ?? ($section['summary'] ?? ''));

        $bullets = [];
        if (!empty($section['bullets']) && is_array($section['bullets'])) {
            foreach ($section['bullets'] as $bullet) {
                $bulletText = valueToPlainString($bullet);
                if ($bulletText !== '') {
                    $bullets[] = $bulletText;
                }
            }
        }

        if ($heading === '' && $body === '' && !$bullets) {
            continue;
        }

        $sections[] = [
            'heading' => $heading,
            'body'    => $body,
            'bullets' => $bullets,
        ];
    }

    return $sections;
}

function normaliseLayout($value): ?string {
    if (!is_string($value)) {
        return null;
    }
    $normalized = strtolower(trim($value));
    $allowed = ['company', 'team', 'general'];
    return in_array($normalized, $allowed, true) ? $normalized : null;
