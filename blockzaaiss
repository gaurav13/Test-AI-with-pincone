function classify_query_type($query) {
    $messages = [
        [
            "role" => "system",
            "content" => "You're a query classifier for a Web3 assistant. Classify this query as:
- 'team_search' if it is asking about a person or team member,
- 'company_search' if it asks about a company,
- 'general_chat' if it's a general question or not related to a person or company."
        ],
        [
            "role" => "user",
            "content" => "Query: $query"
        ]
    ];

    $ch = curl_init('https://api.openai.com/v1/chat/completions');
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_POSTFIELDS => json_encode([
            "model" => "gpt-4o",
            "messages" => $messages
        ]),
        CURLOPT_HTTPHEADER => [
            "Authorization: Bearer " . OPENAI_API_KEY,
            "Content-Type: application/json"
        ]
    ]);

    $response = curl_exec($ch);
    curl_close($ch);
    $result = json_decode($response, true);

    return trim(strtolower($result['choices'][0]['message']['content'] ?? 'general_chat'));
}
