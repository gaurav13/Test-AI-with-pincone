<?php
/**
 *
 */

ini_set('display_errors', '0');
error_reporting(E_ALL);

// -------------------------------------------------------------------
// Configuration
// -------------------------------------------------------------------
$OPENAI_API_KEY       = trim(getenv('OPENAI_API_KEY')       ?: '');
$OPENAI_EMBED_MODEL   = getenv('OPENAI_EMBEDDING_MODEL') ?: '';
$OPENAI_CHAT_MODEL    = getenv('OPENAI_CHAT_MODEL')    ?: '';
$PINECONE_API_KEY     = getenv('PINECONE_API_KEY')     ?: '';
$PINECONE_HOST        = rtrim(getenv('PINECONE_HOST') ?: '', '/');

$DEFAULT_SUGGESTIONS = [
    'What upcoming Web3 opportunities should I watch?',
    'How can Blockza help me discover partners faster?',
    'Which Blockza tools drive community growth?',
];

// -------------------------------------------------------------------
// CORS boilerplate
// -------------------------------------------------------------------
$allowedOrigins = [
    'https://blockza.io',
    'https://www.blockza.io',
    'https://blockza.ai',
    'https://www.blockza.ai',
    'http://localhost:3000',
    'http://localhost:5173',
];
$origin = $_SERVER['HTTP_ORIGIN'] ?? '';

if ($origin && in_array($origin, $allowedOrigins, true)) {
    header('Access-Control-Allow-Origin: ' . $origin);
} else {
    header('Access-Control-Allow-Origin: https://blockza.io');
}
header('Access-Control-Allow-Headers: Content-Type, Authorization');
header('Access-Control-Allow-Methods: POST, OPTIONS');
header('Access-Control-Allow-Credentials: true');

if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
    http_response_code(204);
    exit;
}

if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    http_response_code(200);
    header('Content-Type: text/plain; charset=utf-8');
    echo 'Blockza AI API is running.';
    exit;
}

// -------------------------------------------------------------------
// Check configuration
// -------------------------------------------------------------------
if (!$OPENAI_API_KEY || !$PINECONE_API_KEY || !$PINECONE_HOST) {
    sendJson(500, [
        'error'   => 'CONFIG_ERROR',
        'message' => 'Server missing OpenAI/Pinecone configuration.',
    ]);
}

// -------------------------------------------------------------------
// Handle POST request
// -------------------------------------------------------------------
$payload    = json_decode(file_get_contents('php://input'), true);
$query      = isset($payload['query']) ? trim((string)$payload['query']) : '';
$debugMode  = !empty($payload['debug']);

if ($query === '') {
    sendJson(400, [
        'error'   => 'INVALID_QUERY',
        'message' => 'Please provide a question.',
    ]);
}

try {
    // 1. Generate embedding from OpenAI
    $embeddingResponse = openaiPost(
        'https://api.openai.com/v1/embeddings',
        [
            'input'      => $query,
            'model'      => $OPENAI_EMBED_MODEL,
            'dimensions' => 256,
        ],
        $OPENAI_API_KEY
    );
    $embedding = $embeddingResponse['data'][0]['embedding'] ?? null;
    if (!$embedding || !is_array($embedding)) {
        throw new RuntimeException('OpenAI returned an empty embedding.');
    }

    // 2. Query Pinecone
    $pineconeResponse = pineconePost(
        $PINECONE_HOST . '/query',
        [
            'vector'          => $embedding,
            'topK'            => 3,
            'includeMetadata' => true,
        ],
        $PINECONE_API_KEY
    );
    $matches = isset($pineconeResponse['matches']) && is_array($pineconeResponse['matches'])
        ? $pineconeResponse['matches'] : [];

    $fallbackContext = buildContext($matches);
    $chatgptResult = ask_chatgpt($query, $fallbackContext, $OPENAI_CHAT_MODEL, $OPENAI_API_KEY);

    // 3. Decide which template to use and build the response from metadata
    $primaryMatch = $matches[0] ?? [];
    $otherMatches = array_slice($matches, 1);

    $renderMode = determineResponseMode($query, $matches);
    // 4. Metadata + related companies
    $topMatch   = $primaryMatch;
    $metadata   = $topMatch['metadata'] ?? [];
    $company    = $metadata['company'] ?? $metadata['company_name'] ?? $metadata['name'] ?? $metadata['title'] ?? $metadata['slug'] ?? '';
    $category   = $metadata['category'] ?? $metadata['category_name'] ?? $metadata['industry'] ?? $metadata['segment'] ?? '';
    $layout = $renderMode === 'insight' ? 'general' : $renderMode;
    $companyData = buildCompanyDataFromMatch($primaryMatch);
    $teamMembersRaw = extractTeamMembersFromMetadata($metadata);
    $teamData = mapTeamMembersForResponse($teamMembersRaw, $companyData['name'] ?? '');
    $primaryPersonData = null;

    if ($layout === 'team' && $teamMembersRaw) {
        [$highlightMember, $orderedMembers] = selectTeamMemberForQuery($query, $teamMembersRaw);
        if ($highlightMember) {
            $primaryPersonData = formatTeamMemberForResponse(
                $highlightMember,
                $companyData['name'] ?? '',
                true
            );
            if (empty($primaryPersonData['name'])) {
                $primaryPersonData = null;
            }
        }
        if (!empty($orderedMembers)) {
            $teamData = mapTeamMembersForResponse(
                $orderedMembers,
                $companyData['name'] ?? '',
                $primaryPersonData && isset($primaryPersonData['name'])
                    ? [$primaryPersonData['name']]
                    : []
            );
        }
    }

    $similarSource = $matches;
    if (!empty($similarSource) && $layout === 'company') {
        $similarSource = array_slice($similarSource, 1);
    }
    $similarCompaniesDetailed = buildSimilarCompaniesData($similarSource);

    $modelData = !empty($chatgptResult['parsed']) && is_array($chatgptResult['parsed'])
        ? $chatgptResult['parsed']
        : [];

    $chatgptLayout = normaliseLayout($modelData['layout'] ?? null);
    if ($chatgptLayout !== null) {
        $layout = $chatgptLayout;
    }

    $companyData = mergeCompanyData(
        $companyData,
        normaliseModelCompany($modelData['company'] ?? null)
    );

    $gptCompanyDescription = valueToRichText($modelData['company']['description'] ?? ($modelData['summary']['description'] ?? ''));
    if ($gptCompanyDescription !== '') {
        if (!is_array($companyData)) {
            $companyData = [];
        }
        $companyData['description'] = $gptCompanyDescription;
    }

    $primaryPersonData = mergePersonData(
        $primaryPersonData,
        normaliseModelPerson(
            $modelData['primaryPerson'] ?? null,
            $companyData['name'] ?? '',
            $layout === 'team'
        )
    );

    $modelTeamRaw = normaliseModelTeamMembers($modelData['team'] ?? null);
    if ($modelTeamRaw) {
        $teamMembersRaw = mergeTeamMemberSources($teamMembersRaw, $modelTeamRaw);
        $teamData = mapTeamMembersForResponse(
            $teamMembersRaw,
            $companyData['name'] ?? '',
            $primaryPersonData && isset($primaryPersonData['name'])
                ? [$primaryPersonData['name']]
                : []
        );
    }

    $similarCompaniesDetailed = mergeSimilarCompanies(
        $similarCompaniesDetailed,
        normaliseModelSimilarCompanies($modelData['similarCompanies'] ?? null)
    );

    $similarCompaniesDetailed = shuffleSimilarCompanies(
        $similarCompaniesDetailed,
        $companyData['name'] ?? ''
    );

    $summaryData = buildSummaryForLayout(
        $layout,
        [
            'company'       => $companyData,
            'primaryPerson' => $primaryPersonData,
            'modelSummary'  => $modelData['summary'] ?? null,
        ]
    );
    $sectionsData = buildSectionsForLayout($layout, $modelData);

    $modelSuggestions = [];
    if (!empty($modelData['suggestions']) && is_array($modelData['suggestions'])) {
        foreach ($modelData['suggestions'] as $suggestion) {
            $suggestionString = valueToPlainString($suggestion);
            if ($suggestionString !== '') {
                $modelSuggestions[] = $suggestionString;
            }
        }
    }

    $responsePayload = [
        'layout'           => $layout,
        'company'          => $companyData,
        'primaryPerson'    => $primaryPersonData,
        'team'             => array_values($teamData),
        'similarCompanies' => $similarCompaniesDetailed,
        'summary'          => $summaryData,
        'sections'         => $sectionsData,
        'suggestions'      => [],
        'matchedCategory'  => $category ?: $company ?: '',
    ];

    $assistantReplyContext = summariseResponseForSuggestions($responsePayload);
    $generatedSuggestions = generate_suggestions(
        $query,
        $assistantReplyContext,
        $companyData['name'] ?? '',
        $category ?: $company ?: ''
    );

    if (!empty($generatedSuggestions)) {
        $finalSuggestions = $generatedSuggestions;
    } elseif (!empty($modelSuggestions)) {
        $finalSuggestions = $modelSuggestions;
    } else {
        $finalSuggestions = $DEFAULT_SUGGESTIONS;
    }

    $responsePayload['suggestions'] = $finalSuggestions;

    if ($debugMode) {
        $responsePayload['debug'] = [
            'renderMode'   => $renderMode,
            'chatgpt_raw'  => $chatgptResult['raw'] ?? null,
            'chatgpt_error'=> $chatgptResult['error'] ?? null,
            'matches'      => $matches,
        ];
    }

    // 6. Send JSON response
    sendJson(200, $responsePayload);

} catch (Throwable $e) {
    error_log('Blockza AI PHP proxy error: ' . $e->getMessage());
    sendJson(502, [
        'error'   => 'AI_BACKEND_ERROR',
        'message' => $e->getMessage() ?: 'The AI service is currently unavailable.',
    ]);
}

// -------------------------------------------------------------------
// Helper functions
// -------------------------------------------------------------------

function sendJson(int $status, array $payload): void {
    http_response_code($status);
    header('Content-Type: application/json; charset=utf-8');
    echo json_encode($payload, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
    exit;
}

if (!function_exists('str_starts_with')) {
    function str_starts_with(string $haystack, string $needle): bool {
        return $needle === '' || strpos($haystack, $needle) === 0;
    }
}

if (!function_exists('str_contains')) {
    function str_contains(string $haystack, string $needle): bool {
        return $needle === '' ? true : strpos($haystack, $needle) !== false;
    }
}

function blockza_contains(string $haystack, string $needle): bool {
    return $needle === '' ? true : strpos($haystack, $needle) !== false;
}

function blockza_contains_word(string $haystack, string $needle): bool {
    $needle = trim($needle);
    if ($needle === '') {
        return false;
    }

    $pattern = '/\b' . preg_quote($needle, '/') . '\b/iu';
    return (bool)preg_match($pattern, $haystack);
}

function buildContext(array $matches): string {
    if (empty($matches)) {
        return '';
    }

    $chunks = [];
    foreach ($matches as $index => $match) {
        if (!is_array($match)) {
            continue;
        }

        $headerParts = ['Match ' . ($index + 1)];
        if (!empty($match['id'])) {
            $headerParts[] = 'ID: ' . (string)$match['id'];
        }
        if (isset($match['score'])) {
            $headerParts[] = 'Score: ' . number_format((float)$match['score'], 4);
        }

        $metadata = isset($match['metadata']) && is_array($match['metadata']) ? $match['metadata'] : [];
        $metaJson = $metadata
            ? json_encode($metadata, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE)
            : '';

        $chunks[] = implode(' | ', $headerParts) . ($metaJson !== '' ? "\n" . $metaJson : '');
    }

    return implode("\n\n", $chunks);
}

function ask_chatgpt(string $query, string $context, string $model, string $apiKey): array {
    $result = [
        'raw'    => null,
        'parsed' => null,
        'error'  => null,
    ];

    if ($model === '' || $apiKey === '') {
        $result['error'] = 'CHATGPT_CONFIG_MISSING';
        return $result;
    }

    $systemPrompt = <<<EOT
You are Blockza AI, a Web3 analyst. Reply with a single valid JSON object (no Markdown, no commentary). Use UTF-8 and keep values concise. Structure:
{
  "layout": "company" | "team" | "general",
  "company": {
    "name": string,
    "tagline": string,
    "description": string,
    "category": string,
    "location": string,
    "website": string,
    "directory": string,
    "logo": string,
    "banner": string,
    "founded": string,
    "teamSize": string,
    "funding": string,
    "focus": string,
    "keywords": string
  },
  "primaryPerson": {
    "name": string,
    "role": string,
    "bio": string,
    "image": string,
    "profileUrl": string
  },
  "team": [
    {
      "name": string,
      "role": string,
      "bio": string,
      "image": string,
      "profileUrl": string
    }
  ],
  "similarCompanies": [
    {
      "name": string,
      "description": string,
      "directory": string,
      "founder_header_banner": string,
      "founder_logo": string
    }
  ],
  "summary": {
    "title": string,
    "subtitle": string,
    "description": string
  },
  "sections": [
    {
      "heading": string,
      "body": string,
      "bullets": [string]
    }
  ],
  "suggestions": [string]
}
EOT;

    $userPrompt = "User query: " . $query;
    if ($context !== '') {
        $userPrompt .= "\n\nPinecone context:\n" . $context;
    }

    $payload = [
        'model' => $model,
        'messages' => [
            ['role' => 'system', 'content' => $systemPrompt],
            ['role' => 'user', 'content' => $userPrompt],
        ],
        'temperature' => 1.0,
        'response_format' => ['type' => 'json_object'],
    ];

    try {
        $response = httpJsonPost(
            'https://api.openai.com/v1/chat/completions',
            $payload,
            ['Authorization: Bearer ' . $apiKey]
        );

        $content = $response['choices'][0]['message']['content'] ?? '';
        if (!is_string($content) || trim($content) === '') {
            $result['error'] = 'CHATGPT_EMPTY_RESPONSE';
            return $result;
        }

        $result['raw'] = $content;
        $decoded = json_decode($content, true);
        if (json_last_error() === JSON_ERROR_NONE && is_array($decoded)) {
            $result['parsed'] = $decoded;
        } else {
            $result['error'] = 'CHATGPT_JSON_DECODE_ERROR: ' . json_last_error_msg();
        }
    } catch (Throwable $e) {
        $result['error'] = $e->getMessage();
    }

    return $result;
}

function summariseResponseForSuggestions(array $payload): string {
    $parts = [];

    $summary = $payload['summary'] ?? [];
    if (!empty($summary['title'])) {
        $parts[] = 'Title: ' . valueToPlainString($summary['title']);
    }
    if (!empty($summary['subtitle'])) {
        $parts[] = 'Subtitle: ' . valueToPlainString($summary['subtitle']);
    }
    if (!empty($summary['description'])) {
        $parts[] = 'Summary: ' . valueToPlainString($summary['description']);
    }

    $company = $payload['company'] ?? [];
    if (!empty($company['name'])) {
        $parts[] = 'Company: ' . valueToPlainString($company['name']);
    }
    if (!empty($company['description'])) {
        $parts[] = 'Company Overview: ' . valueToPlainString($company['description']);
    }
    if (!empty($company['focus'])) {
        $parts[] = 'Focus Areas: ' . valueToPlainString($company['focus']);
    }

    if (!empty($payload['sections']) && is_array($payload['sections'])) {
        foreach ($payload['sections'] as $section) {
            if (!is_array($section)) {
                continue;
            }
            $heading = valueToPlainString($section['heading'] ?? '');
            $body = valueToPlainString($section['body'] ?? '');

            if ($heading !== '') {
                $parts[] = 'Section: ' . $heading;
            }
            if ($body !== '') {
                $parts[] = $body;
            }
        }
    }

    $text = implode("\n", array_filter($parts));
    if ($text === '') {
        return '';
    }

    return truncateText($text, 1200);
}

function generate_suggestions(string $query, string $assistantReply = '', string $matchedCompany = '', string $category = ''): array {
    global $OPENAI_API_KEY, $OPENAI_CHAT_MODEL;

    if ($OPENAI_API_KEY === '') {
        return [];
    }

    $replyExcerpt = $assistantReply !== '' ? truncateText($assistantReply, 1500) : '';

    $systemMessage = <<<EOT
You are a smart AI assistant helping users explore Blockza — a Web3 directory, discovery, and matchmaking platform.

Generate 3 to 5 short, natural-sounding follow-up questions that:
- Are based on the user's original query AND the assistant's previous response.
- Use 6 to 15 words each.
- Sound like logical next questions.
- Stay helpful, relevant, and subtly promote Blockza’s value (directories, meetings, visibility, tools).
- Avoid heavy jargon or generic filler.
- Ensure either the first or second suggestion explicitly mentions how Blockza can help.

Return a JSON object: {"suggestions": ["question 1", "question 2"]}.
EOT;

    $userMessage = <<<EOT
Original User Query: {$query}

Assistant's Response: {$replyExcerpt}

Company: {$matchedCompany}
Category: {$category}
EOT;

    $payload = [
        'model' => $OPENAI_CHAT_MODEL ?: 'gpt-4o',
        'messages' => [
            ['role' => 'system', 'content' => $systemMessage],
            ['role' => 'user', 'content' => $userMessage],
        ],
        'temperature' => 0.6,
        'response_format' => ['type' => 'json_object'],
    ];

    try {
        $response = httpJsonPost(
            'https://api.openai.com/v1/chat/completions',
            $payload,
            ['Authorization: Bearer ' . $OPENAI_API_KEY]
        );
        $content = $response['choices'][0]['message']['content'] ?? '';
        if (!is_string($content) || trim($content) === '') {
            return [];
        }
        $decoded = json_decode($content, true);
        if (!is_array($decoded) || empty($decoded['suggestions']) || !is_array($decoded['suggestions'])) {
            return [];
        }
        $suggestions = [];
        foreach ($decoded['suggestions'] as $suggestion) {
            $text = valueToPlainString($suggestion);
            if ($text !== '') {
                $suggestions[] = $text;
            }
        }
        return array_slice($suggestions, 0, 5);
    } catch (Throwable $e) {
        error_log('Blockza suggestion generation failed: ' . $e->getMessage());
        return [];
    }
}

function blockza_is_list(array $array): bool {
    $expectedKey = 0;
    foreach ($array as $key => $_) {
        if ($key !== $expectedKey) {
            return false;
        }
        $expectedKey++;
    }
    return true;
}

function slugify(string $value): string {
    $value = strtolower(trim($value));
    $value = preg_replace('/[^a-z0-9]+/i', '-', $value);
    return trim($value, '-');
}

function ensureUrl(string $value): string {
    $trimmed = trim($value);
    if ($trimmed === '') {
        return '';
    }
    if (preg_match('/^(https?:|data:)/i', $trimmed)) {
        return $trimmed;
    }
    if (str_starts_with($trimmed, '//')) {
        return 'https:' . $trimmed;
    }
    if (str_starts_with($trimmed, '/')) {
        return 'https://blockza.io' . $trimmed;
    }
    if (str_starts_with($trimmed, 'www.')) {
        return 'https://' . $trimmed;
    }
    if (preg_match('/^[a-z0-9\-]+\.[a-z0-9\-]+/i', $trimmed)) {
        return 'https://' . $trimmed;
    }
    return 'https://blockza.io/' . ltrim($trimmed, '/');
}

function sanitizeIdFragment(string $value): string {
    $slug = preg_replace('/[^a-z0-9]+/i', '', $value);
    return $slug !== '' ? $slug : 'Member';
}

function valueToPlainString($value): string {
    if (is_string($value)) {
        $trimmed = trim($value);
        if ($trimmed === '') {
            return '';
        }
        return trim(strip_tags($trimmed));
    }
    if (is_numeric($value)) {
        return (string)$value;
    }
    if (is_bool($value)) {
        return $value ? 'Yes' : 'No';
    }
    if (is_array($value)) {
        $parts = [];
        foreach ($value as $item) {
            $str = valueToPlainString($item);
            if ($str !== '') {
                $parts[] = $str;
            }
        }
        return $parts ? implode(', ', array_unique($parts)) : '';
    }
    return '';
}
function valueToRichText($value, array $allowedTags = ['p', 'br', 'strong', 'em', 'ul', 'ol', 'li', 'a']): string {
    if (!is_string($value)) {
        return valueToPlainString($value);
    }
    $trimmed = trim($value);
    if ($trimmed === '') {
        return '';
    }
    $allowList = '<' . implode('><', $allowedTags) . '>';
    return trim(strip_tags($trimmed, $allowList));
}

function getMetaString(array $metadata, array $keys): string {
    foreach ($keys as $key) {
        foreach ($metadata as $metaKey => $value) {
            if (!is_string($metaKey)) {
                continue;
            }
            if (strcasecmp($metaKey, $key) === 0) {
                $string = valueToPlainString($value);
                if ($string !== '') {
                    return $string;
                }
            }
        }
    }
    return '';
}

function truncateText(string $value, int $limit = 280): string {
    if ($limit <= 0) {
        return '';
    }

    $length = function_exists('mb_strlen') ? mb_strlen($value) : strlen($value);
    if ($length <= $limit) {
        return $value;
    }

    $slice = function_exists('mb_substr')
        ? mb_substr($value, 0, $limit - 1)
        : substr($value, 0, $limit - 1);

    return rtrim($slice) . '…';
}

function extractTeamMembersFromMetadata(array $metadata): array {
    $teamKeys = ['team_members', 'teamMembers', 'team', 'leaders', 'executives', 'people', 'staff'];

    foreach ($teamKeys as $key) {
        foreach ($metadata as $metaKey => $value) {
            if (!is_string($metaKey) || strcasecmp($metaKey, $key) !== 0) {
                continue;
            }

            if (is_string($value)) {
                $decoded = json_decode($value, true);
                if (is_array($decoded)) {
                    $value = $decoded;
                }
            }

            if (!is_array($value)) {
                continue;
            }

            if (isset($value['members']) && is_array($value['members'])) {
                $value = $value['members'];
            }

            if (!blockza_is_list($value)) {
                $value = array_values($value);
            }

            $team = [];
            foreach ($value as $member) {
                if (!is_array($member)) {
                    continue;
                }

                $name = getMetaString($member, ['name', 'fullName', 'displayName']);
                if ($name === '') {
                    continue;
                }

                $role = getMetaString($member, ['role', 'title', 'position', 'designation', 'job_title', 'jobTitle']);
                $description = getMetaString($member, ['description', 'bio', 'summary', 'about', 'focus']);
                $image = ensureUrl(getMetaString($member, ['image', 'imageUrl', 'image_url', 'photo', 'photoUrl', 'photo_url', 'avatar', 'avatarUrl', 'avatar_url', 'headshot']));
                $profileUrl = ensureUrl(getMetaString($member, ['profileUrl', 'profile_url', 'profileLink', 'profile_link', 'profile', 'link', 'page', 'url']));

                $team[] = [
                    'name'        => $name,
                    'role'        => $role,
                    'description' => $description,
                    'image'       => $image,
                    'profileUrl'  => $profileUrl,
                ];
            }

            if ($team) {
                return $team;
            }
        }
    }

    return [];
}

function buildSimilarCompaniesData(array $matches): array {
    $items = [];

    foreach ($matches as $match) {
        if (!is_array($match)) {
            continue;
        }

        $snapshot = normaliseCompanySnapshot($match);
        $name = $snapshot['name'] ?? '';
        if ($name === '') {
            continue;
        }

        $metadata = isset($match['metadata']) && is_array($match['metadata'])
            ? $match['metadata']
            : [];

        $banner = ensureUrl(getMetaString($metadata, [
            'banner',
            'Founder_header_banner',
            'team_header_image',
            'banner_url',
            'bannerUrl',
            'cover',
            'image',
            'image_url',
            'imageUrl'
        ]));

        $items[] = [
            'name'        => $name,
            'description' => truncateText(
        $snapshot['description'] ?: ($snapshot['tagline'] ?? ''),
        160
    ),
            'directory'   => $snapshot['directory'] ?? '',
            'banner'      => $banner,
            'logo'        => $snapshot['logo'] ?? '',
        ];
    }

    return $items;
}

function buildCompanyDataFromMatch(?array $match): ?array {
    if (empty($match) || !isset($match['metadata']) || !is_array($match['metadata'])) {
        return null;
    }

    $metadata = $match['metadata'];
    $snapshot = normaliseCompanySnapshot($match);
    $name = $snapshot['name'] ?? '';
    if ($name === '') {
        return null;
    }

    $banner = ensureUrl(getMetaString($metadata, [
        'banner',
        'Founder_header_banner',
        'team_header_image',
        'banner_url',
        'bannerUrl',
        'cover',
        'cover_image',
        'coverImage',
        'hero',
        'heroImage',
