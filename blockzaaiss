function determineResponseMode(string $query, array $matches): string {
    $plainQuery = trim($query);
    if ($plainQuery === '') {
        return 'company';
    }
    $lowerQuery = strtolower($plainQuery);

    $teamMembers = collectTeamMembersFromMatches($matches);
    foreach ($teamMembers as $member) {
        $name = strtolower($member['name'] ?? '');
        if ($name !== '' && stripos($plainQuery, $name) !== false) {
            return 'team';
        }

        $parts = preg_split('/\s+/', $name);
        foreach ($parts as $part) {
            if (strlen($part) >= 3 && blockza_contains_word($plainQuery, $part)) {
                return 'team';
            }
        }

        $role = strtolower($member['role'] ?? '');
        if ($role !== '') {
            $roleIndicators = ['ceo', 'cto', 'cfo', 'cmo', 'coo', 'founder', 'lead', 'head', 'director'];
            foreach ($roleIndicators as $indicator) {
                if (blockza_contains_word($plainQuery, $indicator) && blockza_contains($role, $indicator)) {
                    return 'team';
                }
            }
        }
    }

    $teamPhraseIndicators = ['who is', 'team of', 'team from'];
    foreach ($teamPhraseIndicators as $indicator) {
        if (stripos($plainQuery, $indicator) !== false) {
            return 'team';
        }
    }

    $teamWordIndicators = ['team', 'teams', 'leaders', 'leadership', 'executives', 'employees', 'people', 'staff', 'founder', 'founders', 'profile', 'bio', 'meet'];
    foreach ($teamWordIndicators as $indicator) {
        if (blockza_contains_word($plainQuery, $indicator)) {
            return 'team';
        }
    }

    $insightIndicators = ['news', 'update', 'updates', 'opportunity', 'opportunities', 'trend', 'trends', 'compare', 'comparison', 'alternatives', 'alternative', 'partner', 'partnership', 'partners', 'project', 'projects', 'ideas', 'roadmap', 'token', 'tokenomics', 'funding', 'raise', 'investment', 'investors', 'event', 'events', 'conference', 'market', 'analysis', 'report', 'list', 'top'];
    foreach ($insightIndicators as $indicator) {
        if (stripos($plainQuery, $indicator) !== false) {
            return 'insight';
        }
    }

    return 'company';
}

function collectTeamMembersFromMatches(array $matches): array {
    $collection = [];
    foreach ($matches as $match) {
        if (!is_array($match) || empty($match['metadata']) || !is_array($match['metadata'])) {
            continue;
        }
        $team = extractTeamMembersFromMetadata($match['metadata']);
        foreach ($team as $member) {
            $collection[] = $member;
        }
    }
    return $collection;
}

function selectTeamMemberForQuery(string $query, array $teamMembers): array {
    if (!$teamMembers) {
        return [null, []];
    }

    $plainQuery = trim($query);
    $bestIndex = null;

    foreach ($teamMembers as $index => $member) {
        $name = strtolower($member['name'] ?? '');
        if ($name && stripos($plainQuery, $name) !== false) {
            $bestIndex = $index;
            break;
        }

        $parts = preg_split('/\s+/', $name);
        foreach ($parts as $part) {
            if (strlen($part) >= 3 && blockza_contains_word($plainQuery, $part)) {
                $bestIndex = $index;
                break 2;
            }
        }

        $role = strtolower($member['role'] ?? '');
        if ($role !== '') {
            $roleParts = ['ceo', 'cto', 'cfo', 'cmo', 'coo', 'founder', 'lead', 'head'];
            foreach ($roleParts as $part) {
                if (blockza_contains_word($plainQuery, $part) && blockza_contains($role, $part)) {
                    $bestIndex = $index;
                    break 2;
                }
            }
        }
    }

    if ($bestIndex === null) {
        $bestIndex = 0;
    }

    $highlight = $teamMembers[$bestIndex];
    $ordered = $teamMembers;
    unset($ordered[$bestIndex]);
    array_unshift($ordered, $highlight);

    return [$highlight, array_values($ordered)];
}

function normaliseCompanySnapshot(array $match): array {
