function mergePersonData(?array $person, ?array $supplement): ?array {
    $base = $person ?? [];
    if (!$supplement) {
        return $base ?: null;
    }

    foreach ($supplement as $key => $value) {
        if ($key === 'isPrimary') {
            $base['isPrimary'] = (!empty($base['isPrimary']) || !empty($value)) ? true : false;
            continue;
        }
        if ($value === '' || $value === null) {
            continue;
        }
        if (!array_key_exists($key, $base) || $base[$key] === '' || $base[$key] === null) {
            $base[$key] = $value;
        }
    }

    if (!empty($base['name']) && empty($base['bookMeetingId'])) {
        $base['bookMeetingId'] = 'BookMeeting_' . sanitizeIdFragment($base['name']);
    }

    return $base ?: null;
}

