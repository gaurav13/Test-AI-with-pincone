        'founded'     => $founded,
        'teamSize'    => $teamSize,
        'funding'     => $funding,
        'focus'       => $focus,
        'keywords'    => $keywords,
        'facts'       => $facts,
    ];
}

function appendFact(array &$facts, string $label, string $value): void {
    $value = trim((string)$value);
    if ($value === '') {
        return;
    }
    $facts[] = ['label' => $label, 'value' => $value];
}

function mergeCompanyData(?array $company, ?array $modelCompany): ?array {
    $base = $company ?? [];
    if (!$modelCompany) {
        return $base ?: null;
    }

    foreach ($modelCompany as $key => $value) {
        if ($value === '' || $value === null) {
            continue;
        }
        if (!array_key_exists($key, $base) || $base[$key] === '' || $base[$key] === null) {
            $base[$key] = $value;
        }
    }

    $base['facts'] = [];
    appendFact($base['facts'], 'Category', $base['category'] ?? '');
    appendFact($base['facts'], 'Headquarters', $base['location'] ?? '');
    appendFact($base['facts'], 'Founded', $base['founded'] ?? '');
    appendFact($base['facts'], 'Team Size', $base['teamSize'] ?? '');
    appendFact($base['facts'], 'Funding', $base['funding'] ?? '');
    appendFact($base['facts'], 'Focus Areas', $base['focus'] ?? '');
    appendFact($base['facts'], 'Keywords', $base['keywords'] ?? '');

    return $base ?: null;
}

